APP_NAME=Jagrat API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./mentor.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEMO_USER_ID=demo
MAX_CONVERSATION_MESSAGES=12
JOURNAL_MEMORY_LIMIT=5
TEACHING_CANDIDATE_LIMIT=7
MAX_CANDIDATE_EXCERPT_CHARS=1800
SEED_DEMO_ON_STARTUP=false
AUTO_INGEST_TEACHINGS=true
TEACHINGS_JSON_PATH=data/articles.json

DEMO_MODE=false

# Development-only compatibility; keep false for public deployments.
ALLOW_LEGACY_PROFILE_ID=false

# Account sessions
AUTH_SESSION_DAYS=30
PASSWORD_HASH_ITERATIONS=600000
