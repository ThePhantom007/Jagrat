APP_NAME=Jagrat API
ENVIRONMENT=development

# Local default is SQLite. For deployment, paste Neon PostgreSQL connection string here.
DATABASE_URL=sqlite:///./mentor.db

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.1-flash-lite

# Comma-separated frontend origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEMO_USER_ID=demo

MAX_CONVERSATION_MESSAGES=12
JOURNAL_MEMORY_LIMIT=5
TEACHING_CANDIDATE_LIMIT=7
CANDIDATE_TEXT_CHARS=5000

SEED_DEMO_ON_STARTUP=true
AUTO_INGEST_TEACHINGS=true
TEACHINGS_CSV_PATH=data/teachings.csv
